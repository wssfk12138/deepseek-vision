# ============================================================
# deepseek-vision 环境配置（新用户必填）
# 插件不内置任何密钥或默认 API 地址，请复制本文件为 .env 后自行填写：
#   Windows:  Copy-Item assets\env.example .env
#   macOS/Linux: cp assets/env.example .env
# 填写完成后运行 scripts\check_config.py（可加 --ping 实测连通）。
# ============================================================

# 接入方式：custom = 自备 OpenAI 兼容视觉 API（推荐，地址/密钥/模型全部自定）
MCP_OCR_PROVIDER=custom

# API 请求地址（必填，例如 https://api.siliconflow.cn/v1）
MCP_OCR_BASE_URL=

# API Key（必填）
MCP_OCR_API_KEY=

# 视觉模型名（必填，例如 Qwen/Qwen3-VL-32B-Instruct）
MCP_OCR_MODEL=

# ------------------------------------------------------------
# 可选：使用硅基流动预设（只需填 Key，请求地址自动使用官方地址）
# MCP_OCR_PROVIDER=siliconflow
# SILICONFLOW_API_KEY=sk-你的密钥
# SILICONFLOW_MODEL=Qwen/Qwen3-VL-32B-Instruct
#
# 其他可选预设：dashscope（阿里百炼）/ volcengine（火山引擎）/ openai
# DASHSCOPE_API_KEY=your-key
# VOLCENGINE_API_KEY=your-key
# OPENAI_API_KEY=sk-your-key
# ------------------------------------------------------------
