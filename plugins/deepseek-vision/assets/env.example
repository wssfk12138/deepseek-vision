# ============================================================
# deepseek-vision 环境配置模板
# 复制本文件为插件根目录下的 .env 并填入你的密钥：
#   Windows: Copy-Item assets\env.example .env
#   macOS/Linux: cp assets/env.example .env
# 修改后需在 Codex 中重新加载插件（或重启会话）才会生效。
# ============================================================

# Provider 选择（默认 siliconflow）
MCP_OCR_PROVIDER=siliconflow

# === 硅基流动（默认，注册即送免费额度：https://cloud.siliconflow.cn）===
SILICONFLOW_API_KEY=sk-your-key
# 默认视觉模型：Qwen3-VL-32B（付费，通用理解能力强，单张图片约几分钱）
SILICONFLOW_MODEL=Qwen/Qwen3-VL-32B-Instruct
# 省钱 / 纯文字提取场景可改回免费模型：
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-OCR

# === 阿里云百炼（DashScope）===
# DASHSCOPE_API_KEY=your-key
# DASHSCOPE_MODEL=qwen-vl-max

# === 火山引擎（豆包）===
# VOLCENGINE_API_KEY=your-key
# VOLCENGINE_MODEL=doubao-1.5-vision-pro-32k

# === OpenAI ===
# OPENAI_API_KEY=sk-your-key
# OPENAI_MODEL=gpt-4o

# === Anthropic ===
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL=claude-sonnet-4-6

# === 精准 OCR（ocr_precise 工具）===
# 百度 OCR：
# BAIDU_OCR_API_KEY=your-api-key
# BAIDU_OCR_SECRET_KEY=your-secret-key
# 腾讯云 OCR：
# TENCENT_SECRET_ID=your-secret-id
# TENCENT_SECRET_KEY=your-secret-key

# === 自定义 OpenAI 兼容视觉 API ===
# MCP_OCR_PROVIDER=custom
# MCP_OCR_API_KEY=your-key
# MCP_OCR_BASE_URL=https://your-api.com/v1
# MCP_OCR_MODEL=your-vision-model
