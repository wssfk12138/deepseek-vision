    "skills":  "./skills/",
    "mcpServers":  "./.mcp.json",
    "interface":  {
                      "displayName":  "DeepSeek Vision",
                      "shortDescription":  "为 DeepSeek 补上图像识别能力",
                      "longDescription":  "DeepSeek 是纯文本模型，无法直接接收图像。本插件通过读取系统剪贴板（截图 Win+Shift+S 或复制图片）或本地路径获取图片，再由 MCP 服务器调用你自行配置的视觉 API 完成识别，把文字结果交回 DeepSeek 继续推理。支持图像分析、OCR、扫描 PDF 批量转 DOCX、古籍影印区域保留、图片表格转可编辑表格、国际音标专项核对与渲染质检。",
                      "developerName":  "Local developer",
                      "category":  "Productivity",
                      "capabilities":  [
                                           "Interactive"
                                       ],
                      "brandColor":  "#4D6BFE",
                      "defaultPrompt":  [
                                            "看看这张截图里有什么？",
                                            "提取这张图片里的所有文字",
                                            "帮我分析这张图表的内容"
                                        ]
                  }
}